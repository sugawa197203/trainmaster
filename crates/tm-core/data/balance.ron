// 01 §3.2・§5・§6・§7 の初期値(10 §4.3)。値は 10 §3.2 の内部単位の整数だけ。
BalanceSpec(
    format_version: 6,
    map: (width: 40, height: 18, margin: 1, initial_area: (16, 10),
          min_spacing: 4, max_nearest: 10, relax_spacings: [3, 2], attempts_per_stage: 1000),
    company: (max_level: 24, cap_base: 4, cap_step: 2, gauge_num: 7, gauge_den: 10,
              stations_base: 3, stations_per_level: 1),
    params: [
        (key: S1Spawn,          base_yen: 5,      cost_ratio: 10, cost_steps: [(from: 4, ratio: 26), (from: 32, ratio: 20)], intrinsic_max: None,     unlock: 0, value: Geometric(v0: 500,  ratio: 2)),
        (key: S2Fare,           base_yen: 5,      cost_ratio: 10, cost_steps: [(from: 4, ratio: 26), (from: 32, ratio: 20)], intrinsic_max: None,     unlock: 0, value: Geometric(v0: 1,    ratio: 10)),
        // 駅で待てる人数は Lv10〜13 の 4 段だけ 4 倍ずつ(Lv14 から 16 倍)。全部を上限まで上げた駅が満員になりにくい(M8)。
        (key: S3StationCap,     base_yen: 50,     cost_ratio: 10, cost_steps: [(from: 4, ratio: 26), (from: 32, ratio: 20)], intrinsic_max: None,     unlock: 1, value: Geometric(v0: 10,   ratio: 2),
                                value_steps: [(from: 10, ratio: 4), (from: 14, ratio: 2)]),
        (key: S4Platform,       base_yen: 1000,   cost_ratio: 3,  intrinsic_max: Some(8),  unlock: 2, value: Linear(v0: 2,       step: 1)),
        (key: T1Speed,          base_yen: 10,     cost_ratio: 2,  intrinsic_max: Some(10), unlock: 0, value: Linear(v0: 1000,    step: 500)),
        (key: T2Crowding,       base_yen: 100000, cost_ratio: 3,  intrinsic_max: Some(6),  unlock: 4, value: Linear(v0: 4,       step: 1)),
        (key: T3Boarding,       base_yen: 100000, cost_ratio: 10, cost_steps: [(from: 4, ratio: 26), (from: 32, ratio: 20)], intrinsic_max: None,     unlock: 4, value: Geometric(v0: 5,    ratio: 2)),
        (key: T4CarCapacity,    base_yen: 10,     cost_ratio: 10, cost_steps: [(from: 4, ratio: 26), (from: 32, ratio: 20)], intrinsic_max: None,     unlock: 0, value: Geometric(v0: 10,   ratio: 2)),
        (key: T5Cars,           base_yen: 1000,   cost_ratio: 3,  intrinsic_max: Some(9),  unlock: 2, value: Linear(v0: 1,       step: 1)),
        (key: R1MaxTrains,      base_yen: 10000,  cost_ratio: 3,  intrinsic_max: Some(7),  unlock: 3, value: Linear(v0: 1,       step: 1)),
        (key: R2LineSlots,      base_yen: 1000,   cost_ratio: 10, intrinsic_max: Some(5),  unlock: 1, value: Linear(v0: 1,       step: 1)),
        (key: R3Attractiveness, base_yen: 10000,  cost_ratio: 3,  intrinsic_max: Some(10), unlock: 3, value: Linear(v0: 1000,    step: 200)),
    ],
    features: [ (feature: LineExtend, unlock: 0), (feature: BulkBuy, unlock: 0), (feature: Transfer, unlock: 1) ],
    // 駅の S1 は S3 のレベルまで(S3 の解放後)。待てる人数より先にお客さんを増やせない(M9)。
    transit: (dwell_base_ms: 1000, dwell_max_ms: 10000, stop_allowance_s: 2, transfer_cost: 1000, waiting_cap_factor: 10,
              spawn_level_margin: 0),
    // K2 は M8 で 31 → 32(駅で待てる人数を増やして収入が増えた分。100 シードの照合)。level_ratio 200 は IMP-706 のまま。
    economy: (initial_money_yen: 0, goal_pow10: 68,
              track: (c1_yen: 50, level_ratio: 200, tile_ratio: (6, 5), tile_cap: 200, free_below_level: 1),
              // 会社 Lv B(4 以上)で出た駅・作った路線は、S1・S2・S3・T3・T4 が Lv cap(B − 3) の値段より(M8)、
              // 固有上限のある設備は S1 の Lv cap(B − 3) の値段より安くならない(M10)。
              upgrade_floor: (behind: 3, from_level: 4)),
    // 転生(T1)。解放条件は累計収入がゴールの 1 無量大数円。ポイント = 基礎点 + 会社レベル × 2。
    // 強化は転生しても残る。運賃は 1 レベルで 2 倍、電車と路線の枠は 1 レベルで 1 つ増える。
    rebirth: (
        points_base: 5, points_per_level: 2,
        fare_boost_ratio: 2, train_boost_trains: 1, line_boost_slots: 1,
        upgrades: [
            (key: FareBoost,  max: 8, base_cost: 2,  cost_ratio: 2),
            (key: TrainBoost, max: 3, base_cost: 5,  cost_ratio: 3),
            (key: LineBoost,  max: 2, base_cost: 10, cost_ratio: 3),
        ],
    ),
)
